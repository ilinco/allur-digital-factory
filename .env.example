# Настройки подключения к PostgreSQL
user=postgres
password=postgres
host=localhost
port=5432
dbname=postgres
# Для локальной разработки без SSL установите disable (по умолчанию в коде require)
ssl_mode=disable

# Или можно передать готовую строку подключения напрямую:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres